{
  "description": "Record bounded ZDecision lifecycle facts for enabled repositories.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__zdecision_local__show_zdecision_update|mcp__zdecision_local__show_zdecision_recall_confirmation|mcp__zdecision_local__gate_zdecision_turn|Bash|apply_patch|Edit|Write|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
