{
  "description": "Record bounded ZDecision lifecycle facts for enabled repositories.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__zdecision_local__show_zdecision_update",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "zdecision-agent hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
